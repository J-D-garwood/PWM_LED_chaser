module pwm_generator #(
	parameter DUTYCYCLE = 50,
	parameter PERIOD = 0.1,
	parameter INPUT_PERIOD = 0.0001
)(
	input clk,
	input rst_n,
	output reg out,
	output reg error
);
	localparam integer total_cycles = 100*(PERIOD/INPUT_PERIOD);
	localparam integer on_cycles = (DUTYCYCLE/100)*total_cycles;
	localparam integer off_cycles = total_cycles - on_cycles;

	reg [31:0] counter = 32'b0;
	always @(posedge clk) begin
		if (!rst_n) begin
			out = 1'b0;
			error = 1'b0;
		end else begin
			if (counter == total_cycles) begin
				counter = 32'b0;
				out = 1'b0;	
			end else begin
				if(counter<off_cycles) begin	
					out = 1'b0;
				end else begin
					out = 1'b1;
				end
			end
		end
	end
endmodule
